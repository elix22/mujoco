<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET bindings for MuJoCo: MjBindings.cs is generated by generate.sh (never edit it by hand);
       MjHelpers.cs is hand-written. The native library is built by the parent repo's
       scripts/build-mujoco-<os>.sh into ../../libs/<os>/<arch>/release/ and copied to the output of
       every project that references this one. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mujoco</RootNamespace>
    <AssemblyName>Mujoco.NET</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- The generated file has no XML docs and uses C-style names. -->
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
    <MujocoLibsDir>$(MSBuildThisFileDirectory)../../libs/macos/arm64/release/</MujocoLibsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build/**;bin/**;obj/**;SmokeTest/**" />
    <None Include="$(MujocoLibsDir)libmujoco.dylib" Condition="Exists('$(MujocoLibsDir)libmujoco.dylib')" Link="libmujoco.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
